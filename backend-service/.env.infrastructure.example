# Copy this file to .env for local Docker Compose only.
# Replace every change_me value with a URL-safe secret generated locally.

POSTGRES_HOST=postgres
REDIS_HOST=redis
RABBITMQ_HOST=rabbitmq

POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change_me_postgres_admin
POSTGRES_ADMIN_DB=postgres

AUTH_MIGRATOR_PASSWORD=change_me_auth_migrator
AUTH_SERVICE_DB_PASSWORD=change_me_auth_database
ACCOUNT_MIGRATOR_PASSWORD=change_me_account_migrator
ACCOUNT_SERVICE_DB_PASSWORD=change_me_account_database
TRANSACTION_MIGRATOR_PASSWORD=change_me_transaction_migrator
TRANSACTION_SERVICE_DB_PASSWORD=change_me_transaction_database
PAYMENT_MIGRATOR_PASSWORD=change_me_payment_migrator
PAYMENT_SERVICE_DB_PASSWORD=change_me_payment_database
AUDIT_MIGRATOR_PASSWORD=change_me_audit_migrator
AUDIT_SERVICE_DB_PASSWORD=change_me_audit_database

REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis

RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST_ENCODED=%2Fbanking-dev
RABBITMQ_ADMIN_PASSWORD=change_me_rabbit_admin
AUTH_SVC_RABBITMQ_PASSWORD=change_me_auth_rabbit
ACCOUNT_SVC_RABBITMQ_PASSWORD=change_me_account_rabbit
TRANSACTION_SVC_RABBITMQ_PASSWORD=change_me_transaction_rabbit
PAYMENT_SVC_RABBITMQ_PASSWORD=change_me_payment_rabbit
AUDIT_SVC_RABBITMQ_PASSWORD=change_me_audit_rabbit
NOTIFICATION_SVC_RABBITMQ_PASSWORD=change_me_notification_rabbit
DEAD_LETTER_SVC_RABBITMQ_PASSWORD=change_me_dead_letter_rabbit

VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN=change_me_vault_local_root
JWT_SECRET=change_me_jwt_secret
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret
STRIPE_SECRET_KEY=change_me_stripe
STRIPE_WEBHOOK_SECRET=change_me_stripe_webhook
PAYPAL_CLIENT_ID=change_me_paypal_client_id
PAYPAL_CLIENT_SECRET=change_me_paypal
PAYPAL_WEBHOOK_ID=change_me_paypal_webhook
SMTP_HOST=smtp.example.test
SMTP_USER=change_me_smtp_user
SMTP_PASS=change_me_smtp_password
TWILIO_API_KEY=change_me_twilio

# Generated by: npm run vault:init
AUTH_SERVICE_VAULT_ROLE_ID=
AUTH_SERVICE_VAULT_SECRET_ID=
ACCOUNT_SERVICE_VAULT_ROLE_ID=
ACCOUNT_SERVICE_VAULT_SECRET_ID=
TRANSACTION_SERVICE_VAULT_ROLE_ID=
TRANSACTION_SERVICE_VAULT_SECRET_ID=
PAYMENT_SERVICE_VAULT_ROLE_ID=
PAYMENT_SERVICE_VAULT_SECRET_ID=

NGINX_HOST=localhost
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=443
SSL_CERT_PATH=./nginx/certs/self-signed.crt
SSL_KEY_PATH=./nginx/certs/self-signed.key
