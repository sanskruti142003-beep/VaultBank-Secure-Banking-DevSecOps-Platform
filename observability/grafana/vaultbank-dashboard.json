{
  "title": "VaultBank POC Services",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Healthy Service Targets",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "targets": [
        {
          "expr": "sum(up{job=\"vaultbank-services\"})",
          "legendFormat": "up"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service Up",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 8 },
      "targets": [
        {
          "expr": "up{job=\"vaultbank-services\"}",
          "legendFormat": "{{ namespace }}/{{ service }}"
        }
      ]
    }
  ]
}
