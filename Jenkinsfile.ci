pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
    buildDiscarder(
      logRotator(
        numToKeepStr: '20',
        artifactNumToKeepStr: '10'
      )
    )
  }

  environment {
    NODE_OPTIONS = '--max-old-space-size=1024'
    CI = 'true'
  }

  stages {
    stage('01 Checkout') {
      steps {
        cleanWs(deleteDirs: true)

        checkout scm

        sh '''
          set -Eeuo pipefail

          if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
            git fetch --unshallow --tags origin
          else
            git fetch --tags --force --prune origin
          fi

          mkdir -p reports/phase-02-ci-baseline

          git rev-parse HEAD |
            tee reports/phase-02-ci-baseline/git-commit.txt

          git branch --show-current |
            tee reports/phase-02-ci-baseline/git-branch.txt

          git status --porcelain |
            tee reports/phase-02-ci-baseline/git-status-before.txt

          node --version |
            tee reports/phase-02-ci-baseline/node-version.txt

          npm --version |
            tee reports/phase-02-ci-baseline/npm-version.txt
        '''
      }
    }

    stage('02 Repository validation') {
      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/validate-repository.sh 2>&1 |
            tee reports/phase-02-ci-baseline/repository-validation.log

          bash ci/scripts/validate-all-files.sh 2>&1 |
            tee reports/phase-02-ci-baseline/file-hygiene.log

          git diff --check
        '''
      }
    }

    stage('03 Pinned security tool verification') {
      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/verify-tool-versions.sh
        '''
      }
    }

    stage('04 TruffleHog verified-secret gate') {
      steps {
        sh '''
          set -Eeuo pipefail

          bash ci/scripts/run-trufflehog.sh all
        '''
      }
    }

    stage('05 Backend quality gates') {
      steps {
        dir('backend-service') {
          sh '''
            set -Eeuo pipefail

            npm ci --legacy-peer-deps 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-npm-ci.log

            npm run lint:check 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-lint.log

            npm run build:all 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-build.log

            npm test 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-tests.log

            npm run test:cov:all 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-coverage.log

            npm audit --audit-level=high 2>&1 |
              tee ../reports/phase-02-ci-baseline/backend-npm-audit.log

            git diff --exit-code -- \
              package.json \
              package-lock.json
          '''
        }
      }
    }

    stage('06 Frontend quality gates') {
      steps {
        dir('frontend') {
          sh '''
            set -Eeuo pipefail

            npm ci 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-npm-ci.log

            npm run typecheck 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-typecheck.log

            npm run build 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-build.log

            npm audit --audit-level=high 2>&1 |
              tee ../reports/phase-02-ci-baseline/frontend-npm-audit.log

            test -s dist/index.html

            git diff --exit-code -- \
              package.json \
              package-lock.json
          '''
        }
      }
    }

    stage('07 SonarQube Cloud SAST quality gate') {
      when {
        branch 'main'
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'sonarcloud-token',
            variable: 'SONAR_TOKEN'
          )
        ]) {
          sh '''
            set -Eeuo pipefail

            export SONAR_USER_HOME=/var/lib/jenkins/.sonar
            export SONAR_QUALITY_GATE_TIMEOUT=300
            export SONAR_GATE_NAME='Vault Bank POC Quality Gate'
            export SONAR_SYNC_QUALITY_GATE=0
            export SONAR_SERVER_QUALITY_GATE_WAIT=false
            export SONAR_CE_TIMEOUT=300
            export SONAR_CE_POLL_SECONDS=5

            bash ci/scripts/run-sonar.sh
          '''
        }
      }
    }

    stage('08 OWASP Dependency-Check CVSS gate') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          string(
            credentialsId: 'nvd-api-key',
            variable: 'NVD_API_KEY'
          )
        ]) {
          sh '''
            set -Eeuo pipefail

            export DEPENDENCY_CHECK_DATA_DIR=/var/lib/jenkins/dependency-check-data
            export DEPENDENCY_CHECK_RUNTIME_DIR=/var/lib/jenkins/dependency-check-runtime
            export DEPENDENCY_CHECK_FAIL_ON_CVSS=7.0

            bash ci/scripts/run-dependency-check.sh
          '''
        }
      }

      post {
        always {
          junit(
            allowEmptyResults: true,
            testResults: 'reports/phase-05-dependency-check/dependency-check-junit.xml'
          )

          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-05-dependency-check/**',
            fingerprint: true
          )
        }
      }
    }

    stage('09 Trivy filesystem, secret and IaC gate') {
      options {
        timeout(time: 30, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export TRIVY_CACHE_DIR=/var/lib/jenkins/trivy-cache

          bash ci/scripts/run-trivy-fs.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-06-trivy-fs/**',
            fingerprint: true
          )
        }
      }
    }

    stage('10 Deterministic Docker image build') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export DOCKER_BUILDKIT=1
          export LOCAL_IMAGE_PREFIX=vaultbank

          bash ci/scripts/build-images.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-07-build/**',
            fingerprint: true
          )
        }
      }
    }

    stage('11 Trivy container image security gate') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export TRIVY_CACHE_DIR=/var/lib/jenkins/trivy-cache

          bash ci/scripts/scan-images.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-08-trivy-image/**',
            fingerprint: true
          )
        }
      }
    }

    stage('12 Syft SBOM generation and validation') {
      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export SYFT_CHECK_FOR_APP_UPDATE=false

          bash ci/scripts/generate-sboms.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-09-sbom/**',
            fingerprint: true
          )
        }
      }
    }

    stage('13 Cosign AWS KMS signing preflight') {
      options {
        timeout(time: 20, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export AWS_REGION=us-east-1
          export AWS_DEFAULT_REGION=us-east-1
          export AWS_EC2_METADATA_DISABLED=false
          export NO_PROXY="${NO_PROXY:+${NO_PROXY},}169.254.169.254"
          export no_proxy="${no_proxy:+${no_proxy},}169.254.169.254"

          bash ci/scripts/cosign-kms-preflight.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-10-cosign-kms-preflight/**',
            fingerprint: true
          )
        }
      }
    }

    stage('14 Harbor image publication and digest capture') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 45, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'harbor-vault-bank-robot',
            usernameVariable: 'HARBOR_USERNAME',
            passwordVariable: 'HARBOR_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export HARBOR_REGISTRY='harbor.vaultbank.internal:9443'
            export HARBOR_PROJECT='vault-bank'
            export HARBOR_AUTO_SBOM_REQUIRED=0
            export HARBOR_ENSURE_AUTO_SBOM_ENABLED=0
            export HARBOR_AUTO_SBOM_TIMEOUT_SECONDS=900
            export HARBOR_AUTO_SBOM_POLL_SECONDS=15

            bash ci/scripts/publish-images-to-harbor.sh
          '''
        }
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-10-harbor-publish/**',
            fingerprint: true
          )
        }
      }
    }

    stage('15 Trivy Harbor digest security gate') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 60, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'harbor-vault-bank-robot',
            usernameVariable: 'HARBOR_USERNAME',
            passwordVariable: 'HARBOR_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export HARBOR_REGISTRY='harbor.vaultbank.internal:9443'
            export HARBOR_PROJECT='vault-bank'

            bash ci/scripts/scan-harbor-digests.sh
          '''
        }
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-11-trivy-registry/**',
            fingerprint: true
          )
        }
      }
    }

    stage('16 Cosign KMS signatures and SPDX attestations') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 60, unit: 'MINUTES')
      }

      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'harbor-vault-bank-robot',
            usernameVariable: 'HARBOR_USERNAME',
            passwordVariable: 'HARBOR_PASSWORD'
          )
        ]) {
          sh '''
            set -Eeuo pipefail
            set +x

            export AWS_REGION='us-east-1'
            export AWS_DEFAULT_REGION='us-east-1'
            export AWS_EC2_METADATA_DISABLED='false'

            export NO_PROXY="${NO_PROXY:+${NO_PROXY},}169.254.169.254"
            export no_proxy="${no_proxy:+${no_proxy},}169.254.169.254"

            export HARBOR_REGISTRY='harbor.vaultbank.internal:9443'
            export HARBOR_PROJECT='vault-bank'

            bash ci/scripts/sign-attest-harbor-images.sh
          '''
        }
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-12-cosign-oci/**',
            fingerprint: true
          )
        }
      }
    }

    stage('17 Verified release manifest') {
      when {
        branch 'main'
      }

      options {
        timeout(time: 20, unit: 'MINUTES')
      }

      steps {
        sh '''
          set -Eeuo pipefail

          export AWS_REGION='us-east-1'
          export AWS_DEFAULT_REGION='us-east-1'
          export AWS_EC2_METADATA_DISABLED='false'

          export NO_PROXY="${NO_PROXY:+${NO_PROXY},}169.254.169.254"
          export no_proxy="${no_proxy:+${no_proxy},}169.254.169.254"

          bash ci/scripts/create-release-manifest.sh
        '''
      }

      post {
        always {
          archiveArtifacts(
            allowEmptyArchive: true,
            artifacts: 'reports/phase-13-release-manifest/**',
            fingerprint: true
          )
        }
      }
    }

    stage('18 Final evidence check') {
      steps {
        sh '''
          set -Eeuo pipefail

          git status --porcelain --untracked-files=no |
            tee reports/phase-02-ci-baseline/git-status-after.txt

          test ! -s \
            reports/phase-02-ci-baseline/git-status-after.txt

          if [ -f backend-service/coverage/coverage-summary.json ]; then
            cp \
              backend-service/coverage/coverage-summary.json \
              reports/phase-02-ci-baseline/
          fi

          test -s             reports/phase-06-trivy-fs/trivy-fs-combined.json

          test -s             reports/phase-06-trivy-fs/trivy-fs-summary.json

          test -s             reports/phase-06-trivy-fs/secret-misconfig.sarif

          test -s             reports/phase-06-trivy-fs/trivy-fs-table.txt

          grep -Eq             '"critical_vulnerabilities":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"fixable_high_vulnerabilities":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"high_or_critical_secrets":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"high_or_critical_misconfigurations":[[:space:]]*0'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          grep -Eq             '"gate_passed":[[:space:]]*true'             reports/phase-06-trivy-fs/trivy-fs-summary.json

          test -s             reports/phase-07-build/images.txt

          test -s             reports/phase-07-build/image-manifest.json

          IMAGE_COUNT="$(
            wc -l               < reports/phase-07-build/images.txt |
            tr -d '[:space:]'
          )"

          if [ "${IMAGE_COUNT}" -ne 6 ]; then
            echo               "FAIL: expected 6 built images, found ${IMAGE_COUNT}"
            exit 1
          fi

          if grep -Eq             ':latest$'             reports/phase-07-build/images.txt; then
            echo "FAIL: latest image tag is prohibited"
            exit 1
          fi

          while IFS= read -r image; do
            if [ -z "${image}" ]; then
              echo "FAIL: empty image reference"
              exit 1
            fi

            docker image inspect               "${image}"               >/dev/null

            runtime_user="$(
              docker image inspect                 --format '{{.Config.User}}'                 "${image}"
            )"

            case "${runtime_user}" in
              "" | "0" | "root")
                echo                   "FAIL: ${image} has invalid runtime user: ${runtime_user:-empty}"
                exit 1
                ;;
            esac

            echo               "PASS: ${image} runtime user=${runtime_user}"
          done             < reports/phase-07-build/images.txt

          echo             "PASS: CI, security and deterministic image evidence checks completed"

          test -s \
            reports/phase-08-trivy-image/trivy-image-summary.json

          test -s \
            reports/phase-08-trivy-image/trivy-image-summary.txt

          test -s \
            reports/phase-08-trivy-image/trivy-image-metadata.txt

          python3 - <<'PYTHON'
import json
from pathlib import Path

report_root = Path(
    "reports/phase-08-trivy-image"
)

summary_path = (
    report_root / "trivy-image-summary.json"
)

summary = json.loads(
    summary_path.read_text(encoding="utf-8")
)

if summary.get("images_scanned") != 6:
    raise SystemExit(
        "FAIL: Trivy image summary does not contain 6 images"
    )

totals = summary.get("totals") or {}

required_zero = {
    "critical_vulnerabilities": 0,
    "fixable_high_vulnerabilities": 0,
    "high_or_critical_secrets": 0,
    "high_or_critical_misconfigurations": 0,
}

for name, expected in required_zero.items():
    actual = totals.get(name)

    if actual != expected:
        raise SystemExit(
            f"FAIL: {name} expected {expected}, found {actual}"
        )

if summary.get("gate_passed") is not True:
    raise SystemExit(
        "FAIL: Trivy image gate_passed is not true"
    )

images = summary.get("images") or []

if len(images) != 6:
    raise SystemExit(
        f"FAIL: expected 6 image entries, found {len(images)}"
    )

report_requirements = (
    ("json", "*.json"),
    ("table", "*.txt"),
    ("sarif", "*.sarif"),
)

for directory, extension in report_requirements:
    report_count = len(
        list(
            (report_root / directory).glob(extension)
        )
    )

    if report_count != 6:
        raise SystemExit(
            f"FAIL: expected 6 {directory} reports, "
            f"found {report_count}"
        )

print(
    "PASS: six Trivy image reports and "
    "zero-finding security gate verified"
)
PYTHON

          echo \
            "PASS: container-image security evidence checks completed"


          test -s \
            reports/phase-09-sbom/sbom-summary.json

          test -s \
            reports/phase-09-sbom/sbom-summary.txt

          test -s \
            reports/phase-09-sbom/sbom-manifest.json

          test -s \
            reports/phase-09-sbom/sbom-checksums.sha256

          test -s \
            reports/phase-09-sbom/sbom-metadata.txt

          python3 - <<'PYTHON'
import json
from pathlib import Path

report_root = Path(
    "reports/phase-09-sbom"
)

summary_path = (
    report_root / "sbom-summary.json"
)

manifest_path = (
    report_root / "sbom-manifest.json"
)

summary = json.loads(
    summary_path.read_text(encoding="utf-8")
)

manifest = json.loads(
    manifest_path.read_text(encoding="utf-8")
)

expected_summary = {
    "images_processed": 6,
    "syft_json_files": 6,
    "cyclonedx_json_files": 6,
    "spdx_json_files": 6,
    "total_sbom_files": 18,
    "validation_passed": True,
}

for name, expected in expected_summary.items():
    actual = summary.get(name)

    if actual != expected:
        raise SystemExit(
            f"FAIL: SBOM summary {name} "
            f"expected {expected}, found {actual}"
        )

images = manifest.get("images") or []

if len(images) != 6:
    raise SystemExit(
        f"FAIL: expected 6 SBOM manifest entries, "
        f"found {len(images)}"
    )

image_names = [
    row.get("image")
    for row in images
]

if len(set(image_names)) != 6:
    raise SystemExit(
        "FAIL: duplicate images found "
        "in SBOM manifest"
    )

for row in images:
    image = row.get("image", "unknown")

    if row.get("validation_passed") is not True:
        raise SystemExit(
            f"FAIL: SBOM validation failed "
            f"for {image}"
        )

    for format_name in (
        "syft_json",
        "cyclonedx_json",
        "spdx_json",
    ):
        format_data = row.get(format_name) or {}

        file_path = Path(
            format_data.get("file") or ""
        )

        checksum = str(
            format_data.get("sha256") or ""
        )

        if not file_path.is_file():
            raise SystemExit(
                f"FAIL: missing {format_name} "
                f"file for {image}"
            )

        if len(checksum) != 64:
            raise SystemExit(
                f"FAIL: invalid {format_name} "
                f"checksum for {image}"
            )

requirements = (
    (
        "syft-json",
        "*.syft.json",
        6,
    ),
    (
        "cyclonedx-json",
        "*.cdx.json",
        6,
    ),
    (
        "spdx-json",
        "*.spdx.json",
        6,
    ),
)

sbom_root = report_root / "sbom"

for directory, pattern, expected in requirements:
    count = len(
        list(
            (sbom_root / directory).glob(pattern)
        )
    )

    if count != expected:
        raise SystemExit(
            f"FAIL: expected {expected} files "
            f"in {directory}, found {count}"
        )

checksum_lines = [
    line
    for line in (
        report_root / "sbom-checksums.sha256"
    ).read_text(
        encoding="utf-8"
    ).splitlines()
    if line.strip()
]

if len(checksum_lines) != 18:
    raise SystemExit(
        "FAIL: expected 18 SBOM checksum "
        f"entries, found {len(checksum_lines)}"
    )

print(
    "PASS: six images and 18 SBOM files "
    "verified in final evidence"
)
PYTHON

          (
            cd reports/phase-09-sbom

            sha256sum \
              --check \
              sbom-checksums.sha256
          )

          echo \
            "PASS: SBOM files and checksums verified"


          test -s \
            reports/phase-10-cosign-kms-preflight/cosign-preflight-summary.json

          test -s \
            reports/phase-10-cosign-kms-preflight/cosign-preflight-checksums.sha256

          test -s \
            reports/phase-10-cosign-kms-preflight/cosign.pub

          test -s \
            reports/phase-10-cosign-kms-preflight/subject.sigstore.json

          test -s \
            reports/phase-10-cosign-kms-preflight/attestation.sigstore.json

          python3 - <<'PYTHON'
import json
from pathlib import Path

report_root = Path(
    "reports/phase-10-cosign-kms-preflight"
)

summary = json.loads(
    (
        report_root /
        "cosign-preflight-summary.json"
    ).read_text(encoding="utf-8")
)

expected = {
    "cosign_version": "3.1.2",
    "aws_region": "us-east-1",
    "kms_state": "Enabled",
    "kms_usage": "SIGN_VERIFY",
    "kms_spec": "ECC_NIST_P256",
    "blob_kms_verified": True,
    "blob_public_key_verified": True,
    "tamper_rejected": True,
    "attestation_kms_verified": True,
    "attestation_public_key_verified": True,
    "claims_checking_enabled": True,
    "private_key_files": 0,
    "validation_passed": True,
}

for name, expected_value in expected.items():
    actual = summary.get(name)

    if actual != expected_value:
        raise SystemExit(
            f"FAIL: Cosign summary {name} "
            f"expected {expected_value}, found {actual}"
        )

private_key_files = list(
    report_root.glob("*.key")
)

private_key_files.extend(
    path
    for path in report_root.iterdir()
    if path.is_file()
    and "private" in path.name.lower()
)

if private_key_files:
    raise SystemExit(
        "FAIL: private-key-like files found: "
        + ", ".join(
            str(path)
            for path in private_key_files
        )
    )

print(
    "PASS: Cosign AWS KMS preflight evidence verified"
)
PYTHON

          (
            cd \
              reports/phase-10-cosign-kms-preflight

            sha256sum \
              --check \
              cosign-preflight-checksums.sha256
          )

          echo \
            "PASS: Cosign bundles and checksums verified"


          if [ "${BRANCH_NAME:-}" = "main" ]; then
            COSIGN_REPORT_DIR='reports/phase-12-cosign-oci'

            test -s \
              "${COSIGN_REPORT_DIR}/cosign-oci-summary.json"

            test -s \
              "${COSIGN_REPORT_DIR}/cosign-oci-checksums.sha256"

            test -s \
              "${COSIGN_REPORT_DIR}/cosign-kms-public-key.pem"

            python3 - <<'PYTHON'
import json
from pathlib import Path

report_root = Path(
    "reports/phase-12-cosign-oci"
)

summary = json.loads(
    (
        report_root /
        "cosign-oci-summary.json"
    ).read_text(encoding="utf-8")
)

expected = {
    "cosign_version": "3.1.2",
    "aws_region": "us-east-1",
    "registry": (
        "harbor.vaultbank.internal:9443"
    ),
    "project": "vault-bank",
    "predicate_type": (
        "https://spdx.dev/Document"
    ),
    "images_signed": 6,
    "signatures_verified": 6,
    "spdx_attestations_created": 6,
    "spdx_attestations_verified": 6,
    "private_key_files": 0,
    "transparency_log_uploaded": False,
    "registry_tls_verified": True,
    "validation_passed": True,
}

for field, expected_value in expected.items():
    actual_value = summary.get(field)

    if actual_value != expected_value:
        raise SystemExit(
            f"FAIL: Cosign summary {field} "
            f"expected {expected_value}, "
            f"found {actual_value}"
        )

images = summary.get("images") or []

if len(images) != 6:
    raise SystemExit(
        "FAIL: expected six Cosign image results"
    )

services = {
    image.get("service")
    for image in images
}

references = {
    image.get("immutable_reference")
    for image in images
}

if len(services) != 6:
    raise SystemExit(
        "FAIL: Cosign services are not unique"
    )

if len(references) != 6:
    raise SystemExit(
        "FAIL: Cosign digest references are not unique"
    )

for image in images:
    if image.get("signature_verified") is not True:
        raise SystemExit(
            "FAIL: an image signature is not verified"
        )

    if image.get("attestation_verified") is not True:
        raise SystemExit(
            "FAIL: an SPDX attestation is not verified"
        )

print(
    "PASS: Cosign OCI signing evidence verified"
)
PYTHON

            (
              cd "${COSIGN_REPORT_DIR}"

              sha256sum \
                --check \
                cosign-oci-checksums.sha256
            )

            echo \
              "PASS: Cosign signatures, attestations and checksums verified"
          else
            echo \
              "INFO: Cosign OCI evidence check skipped outside main"
          fi

        '''
      }
    }
  }

  post {
    always {
      archiveArtifacts(
        artifacts: 'reports/**,backend-service/coverage/**',
        allowEmptyArchive: true,
        fingerprint: true
      )

      cleanWs(
        deleteDirs: true,
        notFailBuild: true
      )
    }

    failure {
      echo 'NO-GO: the CI baseline failed. Do not merge this change.'
    }

    success {
      echo 'GO: quality, security, deterministic image build and validated SBOM gates passed.'
    }
  }
}
