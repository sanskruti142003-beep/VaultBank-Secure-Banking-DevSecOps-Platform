  post {
    always {
      archiveArtifacts(
        artifacts: 'reports/**,backend-service/coverage/**',
        allowEmptyArchive: true,
        fingerprint: true
      )

      cleanWs(
        deleteDirs: true,
        notFailBuild: true
      )
    }

    failure {
      echo 'NO-GO: the CI baseline failed. Do not merge this change.'
    }

    success {
      echo 'GO: supply-chain gates, Harbor publication and OWASP ZAP baseline DAST completed successfully.'
    }
  }
