import json
from pathlib import Path

report_root = Path(
    "reports/phase-12-cosign-oci"
)

summary = json.loads(
    (
        report_root /
        "cosign-oci-summary.json"
    ).read_text(encoding="utf-8")
)

expected = {
    "cosign_version": "3.1.2",
    "aws_region": "us-east-1",
    "registry": (
        "harbor.vaultbank.internal:9443"
    ),
    "project": "vault-bank",
    "predicate_type": (
        "https://spdx.dev/Document"
    ),
    "images_signed": 6,
    "signatures_verified": 6,
    "spdx_attestations_created": 6,
    "spdx_attestations_verified": 6,
    "private_key_files": 0,
    "transparency_log_uploaded": False,
    "registry_tls_verified": True,
    "validation_passed": True,
}

for field, expected_value in expected.items():
    actual_value = summary.get(field)

    if actual_value != expected_value:
        raise SystemExit(
            f"FAIL: Cosign summary {field} "
            f"expected {expected_value}, "
            f"found {actual_value}"
        )

images = summary.get("images") or []

if len(images) != 6:
    raise SystemExit(
        "FAIL: expected six Cosign image results"
    )

services = {
    image.get("service")
    for image in images
}

references = {
    image.get("immutable_reference")
    for image in images
}

if len(services) != 6:
    raise SystemExit(
        "FAIL: Cosign services are not unique"
    )

if len(references) != 6:
    raise SystemExit(
        "FAIL: Cosign digest references are not unique"
    )

for image in images:
    if image.get("signature_verified") is not True:
        raise SystemExit(
            "FAIL: an image signature is not verified"
        )

    if image.get("attestation_verified") is not True:
        raise SystemExit(
            "FAIL: an SPDX attestation is not verified"
        )

print(
    "PASS: Cosign OCI signing evidence verified"
)
